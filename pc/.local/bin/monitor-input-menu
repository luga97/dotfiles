#!/usr/bin/env bash
# Switch video inputs, independently of Hyprland monitor/workspace layouts.
set -euo pipefail

# One selector/switch at a time, including while DDC is still responding.
exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monitor-input-menu.lock"
flock -n 9 || exit 0

selection=$(omarchy menu select "Monitores · entrada de vídeo" \
  "Ambos → PC" "Ambos → laptop" \
  "TCL → PC" "TCL → laptop" \
  "Dell → PC" "Dell → laptop" -- --width 460) || exit 0

case "$selection" in
  "Ambos → PC") monitors=(tcl dell); input=0x0f ;;
  "Ambos → laptop") monitors=(tcl dell); input=0x11 ;;
  "TCL → PC") monitors=(tcl); input=0x0f ;;
  "TCL → laptop") monitors=(tcl); input=0x11 ;;
  "Dell → PC") monitors=(dell); input=0x0f ;;
  "Dell → laptop") monitors=(dell); input=0x11 ;;
  *) exit 0 ;;
esac

switch_input() {
  # EDID model + serial: independent of ddcutil's display numbering/bus order.
  # Keep the PC/laptop input values from the former Super+F1–F4 bindings.
  case "$1" in
    tcl) timeout 15 ddcutil --model 27G64 --sn 00001 setvcp 60 "$input" ;;
    dell) timeout 15 ddcutil --model 'DELL P2722H' --sn DHMDXT3 setvcp 60 "$input" ;;
  esac
}

# Start both before either screen changes input. Attempt both even if one fails.
pids=()
for monitor in "${monitors[@]}"; do
  switch_input "$monitor" &
  pids+=("$!")
done

failed=()
for index in "${!pids[@]}"; do
  if ! wait "${pids[$index]}"; then
    failed+=("${monitors[$index]}")
  fi
done

if (( ${#failed[@]} )); then
  omarchy notification send -u normal "Monitores: cambio incompleto" \
    "No se pudo cambiar: ${failed[*]}. Selección: $selection" || true
  exit 1
fi

omarchy notification send "Monitores" "$selection" || true
