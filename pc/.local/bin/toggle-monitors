#!/usr/bin/env bash
set -euo pipefail

notify() {
  notify-send -u low -t 2000 "Monitor" "$1" 2>/dev/null || true
}

set_hdmi_mirror() {
  hyprctl keyword monitor "HDMI-A-1,highres,auto,1,mirror,DP-1" 2>/dev/null || true
}

# Robust toggle for DP-2 between solo / separate / mirror states.
# Logic:
# - solo: DP-2 disabled
# - mirror: DP-2 is mirrored to DP-1 (hyprctl shows "mirrorOf: DP-1")
# - separate: otherwise

solo=false
separate=false
mirror=false

# Grab DP-2 block
DP2_STATUS=$(hyprctl monitors all 2>/dev/null | sed -n '/^Monitor DP-2/,/^Monitor /p') || DP2_STATUS=""

if echo "$DP2_STATUS" | grep -q "disabled: true"; then
  solo=true
elif echo "$DP2_STATUS" | grep -q "mirrorOf:"; then
  # If mirrorOf is set, assume mirrored
  mirror=true
else
  separate=true
fi

# Helper: get highest refresh for a resolution (e.g. 2560x1440) on an output
highest_refresh_for() {
  local output="$1"; shift
  local res="$1"; shift
  local available_line
+  available_line=$(hyprctl monitors all 2>/dev/null | sed -n "/^Monitor ${output}/,/^Monitor /p" | grep 'availableModes:' | head -n1 || true)
+  if [ -z "$available_line" ]; then
+    echo ""; return
+  fi
+  echo "$available_line" | grep -oE "${res}@[0-9]+(\.[0-9]+)?" | sed 's/.*@//' | sort -nr | head -n1 || true
 }
 
 # Determine best modes
 DP1_MAX=$(highest_refresh_for "DP-1" "2560x1440")
 DP2_MAX=$(highest_refresh_for "DP-2" "1920x1080")
 
 # Fallbacks if parsing failed
 DP1_MODE="2560x1440@180"
 DP2_MODE="1920x1080@60"
 if [ -n "$DP1_MAX" ]; then
   DP1_MODE="2560x1440@${DP1_MAX}"
 fi
 if [ -n "$DP2_MAX" ]; then
   DP2_MODE="1920x1080@${DP2_MAX}"
 fi
 
 if [ "$solo" = true ]; then
   # SOLO -> SEPARATE
   hyprctl keyword monitor "DP-1,${DP1_MODE},1920x0,1" 2>/dev/null || true
   sleep 2
   hyprctl keyword monitor "DP-2,${DP2_MODE},0x0,1" 2>/dev/null || true
   notify "Display Setup: Extended (DP-1 + DP-2)"
 elif [ "$mirror" = true ]; then
   # MIRROR -> SOLO
   hyprctl keyword monitor "DP-2,disable" 2>/dev/null || true
   notify "Display Setup: Single Monitor (DP-1)"
 elif [ "$separate" = true ]; then
   # SEPARATE -> MIRROR
   hyprctl keyword monitor "DP-1,${DP1_MODE},1920x0,1" 2>/dev/null || true
   sleep 2
   hyprctl keyword monitor "DP-2,${DP2_MODE},0x0,1,mirror,DP-1" 2>/dev/null || true
   notify "Display Setup: Mirror (DP-1 = DP-2)"
 fi
 
 sleep 2
 set_hdmi_mirror
 EOF

chmod +x /home/luis/dotfiles/pc/.local/bin/toggle-monitors

# update user's local copy
cat > /home/luis/.local/bin/toggle-monitors <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

notify() {
  notify-send -u low -t 2000 "Monitor" "$1" 2>/dev/null || true
}

set_hdmi_mirror() {
  hyprctl keyword monitor "HDMI-A-1,highres,auto,1,mirror,DP-1" 2>/dev/null || true
}

# Robust toggle for DP-2 between solo / separate / mirror states.
# Logic:
