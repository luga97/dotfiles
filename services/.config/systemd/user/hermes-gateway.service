[Unit]
Description=Hermes assistant gateway (home server)
After=network-online.target
Wants=network-online.target
ConditionHost=archlinux

[Service]
Type=simple
WorkingDirectory=%h
Environment=HERMES_HOME=%h/.hermes
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/hermes gateway run --external-supervisor
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
