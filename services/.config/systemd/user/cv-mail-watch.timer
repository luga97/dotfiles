# CV mail watch — timer de chequeo cada 30 minutos.
# Para probar a mano: systemctl --user start cv-mail-watch.service

[Unit]
Description=Timer del chequeo de respuestas a postulaciones (cada 30 min)

[Timer]
OnBootSec=2min
OnUnitActiveSec=30min
AccuracySec=15s
Persistent=true
Unit=cv-mail-watch.service

[Install]
WantedBy=timers.target
