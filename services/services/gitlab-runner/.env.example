# Token de autenticación del runner (glrt-…). Copiar a .env (gitignored).
#
# Crear uno nuevo en GitLab (proyecto → Settings → CI/CD → Runners → New project
# runner) o por API:
#   glab api -X POST user/runners \
#     -f runner_type=project_type -f project_id=<PROJECT_ID> \
#     -f description="home-server docker runner" \
#     -f tag_list="home-server" -f locked=true
#
# Solo se usa en el registro inicial (queda guardado en data/config/config.toml).
RUNNER_TOKEN=glrt-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
